 "textband_1900_standing_angles_dog": {
  "source": "Ellenberger, Baum & Dittrich, Handbuch der Anatomie der Tiere fuer Kuenstler: Textband, Leipzig: Dieterich, 1900. https://archive.org/details/bub_gb_4JFmAAAAMAAJ (Public Domain Mark). Read from the OCR text (djvu.txt); OCR errors possible, numbers not checked against page images.",
  "note": "included-angle values as printed (angle between the two bones); bonus, not part of the skin-offset measurement",
  "values": [
   {
    "what": "scapula-humerus (shoulder) angle, dog",
    "value": "115-120 deg"
   },
   {
    "what": "humerus-forearm (elbow) angle, domestic animals generally",
    "value": "140-150 deg"
   },
   {
    "what": "humerus to vertical, dog",
    "value": "30 deg"
   },
   {
    "what": "ilium to horizontal, dog",
    "value": "about 35 deg"
   },
   {
    "what": "pelvis-femur (hip) angle, dog",
    "value": "110 deg"
   },
   {
    "what": "femur-tibia angle, dog",
