  "numbers_from_article (CC BY 4.0)": {
   "dog": "adult Beagle 'Simon', 13.8 kg; CT 3370 sections, 0.33 mm spacing, 512x512 px at 0.279 x 0.279 mm",
   "dofs": "84 DOF max; 134 muscles (67 per side); head, thorax, abdomen and tail 3 rotational DOF each; vertebral motion not modelled; root = thorax joined to ground",
   "forelimb_dofs_used (Table 1)": {
    "global": 3,
    "scapula": 5,
    "shoulder": 3,
    "elbow": 2,
    "carpal joint": 2,
    "forepaw": 3,
    "note": "15 limb DOF needed for static optimisation to converge; scapula needs cranio-caudal AND vertical translation (5 DOF); adding mediolateral scapular translation (16 DOF) made results worse"
   },
   "reserve actuator limits (Table 1)": {
    "scapula": "Mx 5, My 5, Mz 5 Nm; Fy 0.00005, Fz 0.5 N",
    "shoulder": "Mx 0.0005, My 5, Mz 5 Nm",
    "elbow": "Mx 1, My 5 Nm",
    "carpal": "Mx 5, Mz 1 Nm",
    "forepaw": "Mx 0.005, My 0.005, Mz 0.0005 Nm",
    "global": "Fx, Fy, Fz 0.5 N"
   },
   "axes": "local segment frames: rotation about x (red) = protraction/retraction or flexion/extension; about y (yellow) = abduction/adduction; about z (green) = axial rotation (Fig. 7 caption)",
   "segment masses": "as % of 13.8 kg body mass from Amit et al. 2009 volumes + CT (Suppl. 2); inertia from bone point clouds (cloud2). Humerus inertia about CoM (1e-3 kg m^2, diagonal): Andrada 2017 0.435/0.329/0.254; bone geometry 0.513/0.500/0.044; CT segmentation 0.332/0.256/0.178 (Suppl. Table 1)",
   "scaling": "Muscle geometry came from a German Shepherd (working line) anatomical model (Lauströer, Andikfar & Fischer). Beagle bones were scaled up to fit it: both limbs x1.66, spine/neck/head x1.25 (one factor per leg suffices because segment length as % of leg length is about constant across breeds, incl. chondrodystrophic, citing Fischer & Lilje 2011, Lumer 1940, Wayne 1986). Muscle PCSA scaled to Beagle body mass with log relationships from Shahar & Milgram and Williams et al. data; lengths scale with geometry in OpenSim. 'Working versions' on SimTK are the Shepherd-sized model; scale_beagle.zip holds OpenSim scaling data to the Beagle.",
   "joint positions": "joint positions and types derived from the CT-based Beagle model; cylinders constrain hinge joints, spheres ball joints (for muscle wrapping)."
  }
 },
 "greyhound_hindlimb_ellis_2018": {
  "source": {
   "title": "Opensim model and simulation data: greyhound sit-to-stand",
   "authors": "John R. Hutchinson (figshare uploader); model credits Richard G. Ellis, Jeffery W. Rankin, John R. Hutchinson",
   "year": 2018,
   "doi": "10.6084/m9.figshare.7240538.v2",
   "url": "https://figshare.com/articles/dataset/Opensim_model_and_simulation_data_greyhound_sit-to-stand/7240538",
   "file_url": "https://ndownloader.figshare.com/files/13368230",
   "licence": "CC BY 4.0",
   "paper": "Ellis RG, Rankin JW, Hutchinson JR (2018) Limb kinematics, kinetics and muscle dynamics during the sit-to-stand transition in greyhounds. Front Bioeng Biotechnol 6:162. doi:10.3389/fbioe.2018.00162 (PMC6250835, CC BY)",
   "file_extracted": "2018_Greyhound_Hindlimb_Model_Nominal.osim"
  },
  "units": {
   "length": "meters",
   "force": "N",
   "mass": "kg",
   "angles": "rad in file; deg given alongside"
  },
  "axis_convention": {
   "model": "X cranial (forward), Y to the animal's left (lateral for this LEFT hindlimb), Z up; gravity = (0,0,-9.80665). Paper: 'For all joints, the X-axis pointed cranially in the original reference pose (limb fully straightened at 0 deg joint angles). The Y-axis was oriented to the animal's left (lateral) and the Z-axis vertically.'",
   "rotations": "Rx = ab/adduction, Ry = flexion/extension (sagittal), Rz = internal/external rotation; CustomJoint SpatialTransform axes 1 0 0 / 0 1 0 / 0 0 1 with LinearFunction slope 1 (rotation = coordinate value).",
   "sagittal sign (derived by forward kinematics here)": "Hip_Ry negative = hip flexion (femur swings cranially); Knee_Ry positive = stifle flexion (tibia swings caudally); Ankle_Ry negative = hock flexion (metatarsus swings cranially). 0 = limb straight and vertical.",
   "zero pose": "all coordinates 0: limb hangs fully straight below the hip",
   "game side view": "x forward = right (= model X), y down (= -model Z); values in metres, origin at the hip joint centre",
   "frames": "OpenSim 3.0 format (Version 30000): Joint nested in child Body; location_in_parent / orientation_in_parent in the parent body frame; location / orientation in the child body frame (all zero here, so each joint centre is its child body origin). No orientation offsets in this model (all orientation_in_parent = 0)."
  },
  "scaling_notes": [
   "Built in SIMM from CT (GE Lightspeed; 2.5 mm slices, 0.625 mm distal to knee) of one adult greyhound's formalin-preserved LEFT hindlimb (RVC teaching collection); joints from cylinders/spheres fitted to anatomical centres of rotation in 3DS Max (Allen et al. 2013 method).",
   "4 segments (pelvis+torso 'Body', thigh, shank, foot), 3 joints each with 3 rotational DOF; toe joints immobile; 39 musculotendon actuators (29 named muscles in this file's ForceSet with max_isometric_force).",
   "Thigh/shank/foot masses from ray-projection volumes at 1060 kg/m^3; body and head mass from regressions of leg length vs body mass/length of the 8 experimental dogs, then Amit et al. 2009 regressions for torso/head mass and inertia. Modelled hindlimb = 8.4% of estimated body mass.",
   "The .osim is SCALED to the subject of the representative trial with OpenSim's Scale tool using marker segment lengths (femur: greater trochanter to lateral femoral condyle; shank: lateral femoral epicondyle to lateral malleolus; foot: lateral malleolus to head of MT V). Pelvis scale = mean of femur/shank/foot factors. Display scale factors in the file: Body 0.81, Thigh 0.89, Shank 0.76, Foot 0.78 (0.81 = mean of 0.89, 0.76, 0.78). Joint locations in the file are already in scaled metres.",
   "Experimental dogs: 8 pure and half-breed greyhounds (5 M, 3 F), body mass 27 +- 5 kg, torso length 61.0 +- 7 cm, shoulder height 60.5 +- 8 cm, hip height 61.6 +- 3.9 cm.",
   "Model total mass in file = 19.36 kg (Body 16.57 incl. torso/head/other limbs lumped, one hindlimb 2.79).",
   "Coordinate ranges in the file are the model's allowed (clamped) ranges, not measured ROM. Measured sit-to-stand ROM (paper Table 3, mean +- SD, 39 trials, 6 dogs): hip flex/ext 53.4 +- 5.6, add/abd 18.5 +- 9.9, rot 8.7 +- 4.3; knee 78.5 +- 10.7, 30.2 +- 10.2, 25.7 +- 4.9; ankle 88.7 +- 15.7, 23.5 +- 13.3, 51.3 +- 13.7 deg (knee/ankle non-sagittal largely marker artefact; locked in the nominal model)."
  ],
